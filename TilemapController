using UnityEngine;

// 이 스크립트를 넣은 오브젝트와 플레이어가 충돌 시 계단 tilemap을 활성화/비활성화하는 스크립트

public class TilemapController : MonoBehaviour
{
    public GameObject OnTilemap; // 작동시 드러나는 타일 맵
    public GameObject OffTilemap; // 작동시 사라지는 타일 맵


    void Awake()
    {
        OnTilemap.SetActive(false); // 시작 시 숨김
    }

    void OnTriggerEnter2D(Collider2D collision)
    {
        if (collision.CompareTag("Player") && this.CompareTag("Key"))
        {
            OnTilemap.SetActive(true);
            OffTilemap.SetActive(false);
        }
    }

    void OnTriggerExit2D(Collider2D collision)
    {
        if (collision.CompareTag("Player") && this.CompareTag("Key"))
        {
            OnTilemap.SetActive(false);
            OffTilemap.SetActive(true);
        }
    } 
} 
